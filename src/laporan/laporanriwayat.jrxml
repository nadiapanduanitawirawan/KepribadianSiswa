	<property name="ireport.zoom" value="1.9487171000000054"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="68"/>
	<parameter name="P_KEPRIBADIAN" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
     hi.nisn,
     hi.nama_siswa,
     rs.kelas AS kelas_siswa,
     hi.kepribadian,
     hi.persen_introvert,
     hi.persen_ekstrovert,
     hi.saran,
     hi.tanggal
FROM
     hasil_identifikasi hi
     LEFT JOIN regissiswa rs ON hi.nisn = rs.nisn
WHERE ($P{P_KEPRIBADIAN} IS NULL OR hi.kepribadian = $P{P_KEPRIBADIAN})
ORDER BY rs.kelas ASC, hi.nama_siswa ASC]]>
	</queryString>
	<field name="nisn" class="java.lang.String"/>
	<field name="nama_siswa" class="java.lang.String"/>
	<field name="kelas_siswa" class="java.lang.String"/>
	<field name="kepribadian" class="java.lang.String"/>
	<field name="persen_introvert" class="java.lang.Double"/>
	<field name="persen_ekstrovert" class="java.lang.Double"/>
	<field name="saran" class="java.lang.String"/>
	<field name="tanggal" class="java.sql.Timestamp"/>
