	<queryString language="SQL">
		<![CDATA[SELECT
     gejalaa.`id_gejala` AS gejalaa_id_gejala,
     gejalaa.`nama_gejala` AS gejalaa_nama_gejala
FROM
     `gejalaa` gejalaa
ORDER BY
     CAST(SUBSTRING(gejalaa.`id_gejala`,3) AS UNSIGNED)]]>
	</queryString>
