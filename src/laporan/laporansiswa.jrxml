	<property name="ireport.zoom" value="1.9487171000000025"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="34"/>
	<parameter name="P_JURUSAN" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    datasiswa.nisn AS datasiswa_nisn,
    datasiswa.nama_siswa AS datasiswa_nama_siswa,
    datasiswa.kelas AS datasiswa_kelas,
    datasiswa.jurusan AS datasiswa_jurusan,
    datasiswa.jenis_kelamin AS datasiswa_jenis_kelamin
FROM datasiswa
WHERE (
      $P{P_JURUSAN} IS NULL
      OR datasiswa.jurusan = $P{P_JURUSAN}
)
ORDER BY jurusan, nama_siswa]]>
	</queryString>
	<field name="datasiswa_nisn" class="java.lang.String"/>
	<field name="datasiswa_nama_siswa" class="java.lang.String"/>
	<field name="datasiswa_kelas" class="java.lang.String"/>
	<field name="datasiswa_jurusan" class="java.lang.String"/>
	<field name="datasiswa_jenis_kelamin" class="java.lang.String"/>
	<variable name="JUMLAH_DATA" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{datasiswa_nisn}]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
